# MongoDB connection string for property/listing data
MONGO_URI=

# MongoDB connection string for the auth (User) collection
AUTH_MONGO_URI=

# Groq API key (used by the AI chat features)
GROQ_API_KEY=

# JWT signing secret - must be at least 32 characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Port the Express server listens on (optional, defaults to 5000)
PORT=5000

# Set to "production" to enable secure cookies, HSTS, and trust proxy
NODE_ENV=development

# Comma-separated list of additional allowed CORS origins (e.g. production
# frontend URL). localhost origins are always allowed and do not need to be
# listed here.
CORS_EXTRA_ORIGINS=

# Max login/register requests per IP per 15 minutes (optional, defaults to 10).
# Only raised by the API test server so the suite can run repeatedly.
# AUTH_RATE_LIMIT_MAX=10
