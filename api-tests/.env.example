# Copy to .env (same folder) and fill in. .env is gitignored; never commit it.
# Every value here is for the TEST environment only.

# The test server started by scripts/run_test_server.py. Must be localhost.
# Port 5001, not 5000, so the suite never hits a dev server running against real data.
API_BASE_URL=http://localhost:5001

# Test databases. The database name (after the host) MUST end with _test,
# or the suite refuses to start.
TEST_MONGO_URI=mongodb+srv://<user>:<password>@<properties-cluster-host>/Properties_test?retryWrites=true&w=majority
TEST_AUTH_MONGO_URI=mongodb+srv://<user>:<password>@<users-cluster-host>/RealEstateApp_test?retryWrites=true&w=majority

# JWT secret for the test server (at least 32 characters). The suite uses it
# to sign expired tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
TEST_JWT_SECRET=

# The admin created in the test auth DB by scripts/seed_test_admin.py.
TEST_ADMIN_EMAIL=test-admin@example.test
TEST_ADMIN_PASSWORD=

# Optional: seconds before any single HTTP request gives up (default 10).
REQUEST_TIMEOUT_SECONDS=10
